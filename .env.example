# UPSTASH REDIS (Base de datos serverless ultrarrápida para control de licencias y saldo)
# Obtén estas credenciales gratis en https://console.upstash.com/ (Database > REST API)
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# GUMROAD (Verificación de licencias de compra)
# Tu identificador de producto o permalink de Gumroad (ej: 'cartas-magicas-pack' o ID de producto)
GUMROAD_PRODUCT_PERMALINK="cartas-magicas-pack"
GUMROAD_PRODUCT_ID=""

# POLÍTICA DE VALOR "CERO TIMO"
TOTAL_DOWNLOADS_PER_PACK="10"
MAX_NAME_EDITS="2"
MAX_CHILDREN_PER_PACK="6"

