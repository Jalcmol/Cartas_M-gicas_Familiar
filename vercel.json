{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/app/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/.*",
      "dest": "/index.html"
    }
  ]
}
